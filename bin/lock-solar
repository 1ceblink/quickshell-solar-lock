#!/bin/sh
# Lock the screen with the Quickshell solar-system lock.
# If it fails to start or crashes, fall back to hyprlock so the session never stays unlocked.
DIR=$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)   # follows symlinks, so it also works as /usr/bin/solar-lock
pgrep -x hyprlock >/dev/null && exit 0
# textures are downloaded separately (tools/fetch_textures.py); without them use the plain lock
[ -f "$DIR/textures/2k_earth_daymap.jpg" ] || exec hyprlock
# A leftover Quickshell lock process (after a crash, say) must not turn the lock key into a silent no-op, or the
# screen would stay unlocked. Use hyprlock instead: if the session really is locked already it is simply refused.
pgrep -f "$DIR/shell.qml" >/dev/null && exec hyprlock
qs -p "$DIR/shell.qml" && exit 0
exec hyprlock
