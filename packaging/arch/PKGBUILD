# Maintainer: Armen <108435601+1ceblink@users.noreply.github.com>
#
# Install:                   cd packaging/arch && makepkg -si      (builds the release tag v$pkgver from GitHub)
# Latest main:               SOLAR_LOCK_REF=branch=main makepkg -si
# From a local checkout:     SOLAR_LOCK_REPO=file://$(git rev-parse --show-toplevel) makepkg -si   (committed files only)
# From the AUR (planned):    yay -S solar-lock
#
# A release package: it builds exactly the tag v$pkgver. To release: tag the repository, bump pkgver here, run
# `makepkg --printsrcinfo > .SRCINFO`, and push PKGBUILD and .SRCINFO to the AUR.

pkgname=solar-lock
_name=quickshell-solar-lock   # the upstream repository name (also the install folder under /usr/share)
pkgver=1.0.0
pkgrel=1
pkgdesc='Animated, interactive 3D solar-system lockscreen for Wayland (Quickshell) and KDE Plasma'
arch=('any')
url='https://github.com/1ceblink/quickshell-solar-lock'
license=('MIT' 'GPL-2.0-or-later')   # everything is MIT except kde/lockscreen/LockScreen.qml (GPL-2.0-or-later, see its header)
depends=('quickshell' 'qt6-quick3d' 'hyprlock')   # hyprlock provides the PAM service and the crash fallback
makedepends=('git' 'python-pillow')
optdepends=('plasma-workspace: use it as the KDE Plasma lockscreen (solar-lock-install-kde)')

_repo="${SOLAR_LOCK_REPO:-$url.git}"
_ref="${SOLAR_LOCK_REF:-tag=v$pkgver}"   # a release builds exactly its tag
# The planet textures are CC BY 4.0 (Solar System Scope, https://www.solarsystemscope.com/textures/); they are
# downloaded here instead of being stored in the repository.
_tex=https://www.solarsystemscope.com/textures/download
source=("$_name::git+$_repo#$_ref"
        "$_tex/2k_sun.jpg"
        "$_tex/2k_mercury.jpg"
        "$_tex/2k_venus_atmosphere.jpg"
        "$_tex/2k_earth_daymap.jpg"
        "$_tex/2k_earth_clouds.jpg"
        "$_tex/2k_moon.jpg"
        "$_tex/2k_mars.jpg"
        "$_tex/2k_jupiter.jpg"
        "$_tex/2k_saturn.jpg"
        "$_tex/2k_uranus.jpg"
        "$_tex/2k_neptune.jpg"
        "$_tex/2k_saturn_ring_alpha.png"
        "$_tex/2k_stars.jpg"
        "$_tex/2k_earth_nightmap.jpg")
sha256sums=('SKIP'
