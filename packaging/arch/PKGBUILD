build() {
    cd "$srcdir/$_name"
    mkdir -p textures
    cp "$srcdir"/2k_*.jpg "$srcdir"/2k_saturn_ring_alpha.png textures/
    # the downloads are already there, so this only derives the ring disc and the bump maps (no network)
    python tools/fetch_textures.py
}

package() {
    cd "$srcdir/$_name"
    local dest="$pkgdir/usr/share/$_name"

    install -Dm644 shell.qml Scene.qml dev.qml -t "$dest"
    install -Dm644 shaders/earth_night.frag -t "$dest/shaders"
    install -Dm755 bin/lock-solar bin/preview bin/install-kde bin/uninstall-kde -t "$dest/bin"
    install -Dm644 kde/lockscreen/LockScreen.qml -t "$dest/kde/lockscreen"
    install -Dm644 textures/*.jpg textures/*.png -t "$dest/textures"
    install -Dm644 README.md -t "$pkgdir/usr/share/doc/$_name"
    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"

    install -d "$pkgdir/usr/bin"
    ln -s "../share/$_name/bin/lock-solar"     "$pkgdir/usr/bin/solar-lock"
    ln -s "../share/$_name/bin/preview"        "$pkgdir/usr/bin/solar-lock-preview"
    ln -s "../share/$_name/bin/install-kde"    "$pkgdir/usr/bin/solar-lock-install-kde"
    ln -s "../share/$_name/bin/uninstall-kde"  "$pkgdir/usr/bin/solar-lock-uninstall-kde"
}
